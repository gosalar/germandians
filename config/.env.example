# Copy to config/.env.local and fill in. Every value is optional; leaving one
# empty gives the same behaviour as the design's default.

# POST endpoint for the profile review form (JSON body). Empty = open the
# visitor's email app with the details filled in instead.
VITE_FORM_ENDPOINT=

# WhatsApp number in international format, digits only (e.g. 4915123456789).
# Empty = WhatsApp buttons scroll to the form.
VITE_WHATSAPP_NUMBER=

# Service fee shown after admission (e.g. "€1,200"). Empty = "Written quote".
VITE_FEE_AFTER_ADMISSION=

# One of: Not confirmed | Enquiries open | Waitlist only | Enquiries closed
VITE_INTAKE_STATUS=Not confirmed

# Show "N places still open" under the 30-student stat and in the footer.
VITE_SHOW_SEAT_COUNT=false
VITE_SEATS_LEFT=30

# Let visitors wipe and repaint the hero painting.
VITE_ALLOW_REPAINT=true
