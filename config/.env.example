# Copy to config/.env.local and fill in. Every value is optional; leaving one
# empty gives the same behaviour as the design's default.

# Public HTTPS origin, without a path, used for canonical, sharing and sitemap
# URLs. Empty/invalid = https://gosalar.github.io. The deployment path is the
# separate SITE_BASE_PATH variable (local default /; Pages workflow /germandians/).
# For a custom domain, set this to https://<domain> and SITE_BASE_PATH to /.
VITE_SITE_ORIGIN=

# Public HTTPS POST endpoint implementing the README acknowledgement contract:
# 2xx JSON { "received": true } only after durable receipt; errors must not confirm.
# Empty/invalid = an explained email-app handoff. No provider has been selected.
VITE_FORM_ENDPOINT=

# WhatsApp number including country code: 10–15 digits, first digit non-zero.
# Formatting is stripped. Empty/invalid = actions labelled "Open review form".
VITE_WHATSAPP_NUMBER=

# Invitation link to the WhatsApp community that may be published: an HTTPS
# chat.whatsapp.com link, or a whatsapp.com/channel/ link. With one set, the
# community page shows "Join the WhatsApp community". Empty/invalid = no join
# link; the page asks visitors to message us on Instagram about it instead.
VITE_WHATSAPP_COMMUNITY_URL=

# Advertised service fee under the standard arrangement. Empty = "Written quote".
# Timing and any exception must be agreed in the written quote. Long values are
# shown in full in the fee explanation; the receipt says "See quote".
VITE_FEE_AFTER_ADMISSION=

# One of: Not confirmed | Enquiries open | Waitlist only | Enquiries closed
VITE_INTAKE_STATUS=Not confirmed

# Current intake: Winter or Summer, and a four-digit starting year (1000–9999).
# Winter + 2027 displays Winter 2027/28; Summer + 2027 displays Summer 2027.
# Invalid or empty values fall back to Summer and 2027.
VITE_INTAKE_SEASON=Summer
VITE_INTAKE_YEAR=2027

# Privacy details: plain text, without brackets. No assumed legal details.
# Missing values show highlighted reminders in development builds; production
# omits the corresponding clause and warns at build time.
# Registered business name and postal address. Both also appear in the footer
# as "Operated by …"; the build warns while either is missing.
VITE_PRIVACY_NAMES=
VITE_PRIVACY_ADDRESS=
# Used only when VITE_FORM_ENDPOINT is configured.
VITE_PRIVACY_FORM_SERVICE=
VITE_PRIVACY_HOSTING_PROVIDER=
# e.g. 6 months; confirm the actual retention policy before setting this.
VITE_PRIVACY_RETENTION=
VITE_PRIVACY_AUTHORITY=

# Show "N places still open" under the 30-student stat and in the footer.
VITE_SHOW_SEAT_COUNT=false
VITE_SEATS_LEFT=30
