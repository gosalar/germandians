{
  "name": "germandians-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "npm run typecheck && node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "lint": "eslint .",
    "typecheck": "react-router typegen && tsc -b",
    "build:visual": "node scripts/build.mjs --visual",
    "test:visual": "playwright test",
    "test:visual:quick": "playwright test --grep @quick",
    "test:visual:report": "playwright show-report"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@mantine/core": "^9.7.4",
    "@mantine/form": "^9.7.4",
    "@mantine/hooks": "^9.7.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "isbot": "^5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "8.5.1",
    "@rolldown/plugin-babel": "^0.3.0",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/serve-handler": "^6.1.4",
    "@vitejs/plugin-react": "^6.2.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "sass-embedded": "^1.107.1",
    "serve-handler": "^6.1.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  }
